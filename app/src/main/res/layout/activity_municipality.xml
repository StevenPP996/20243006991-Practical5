<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/municipality_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/municipality_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="14dp"
        android:textColor="@color/color_text_light"
        android:textSize="26sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/municipality_image"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/image_rounded_background"
        android:clipToOutline="true"
        android:contentDescription="@string/municipality_image_description"
        android:scaleType="centerCrop" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="@drawable/information_card_background"
        android:fillViewport="true"
        android:padding="16dp">

        <TextView
            android:id="@+id/municipality_information"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5dp"
            android:textSize="16sp" />
    </ScrollView>

    <Button
        android:id="@+id/visit_site_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="@string/visit_site"
        android:textAllCaps="false"
        android:textSize="16sp" />
</LinearLayout>
